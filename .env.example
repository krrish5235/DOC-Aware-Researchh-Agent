# Required — Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-api-key

# Optional — enables Tavily for web search (https://tavily.com, free tier).
# If unset, the agent falls back to DuckDuckGo, which needs no key.
TAVILY_API_KEY=

# Optional overrides
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=models/text-embedding-004
