# Required — Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-api-key

# Optional — enables Tavily for web search (https://tavily.com, free tier).
# If unset, the agent falls back to DuckDuckGo, which needs no key.
TAVILY_API_KEY=

# Optional overrides
# gemini-3.5-flash-lite: works for new API keys and has the largest free-tier
# daily quota. `gemini-flash-latest` is an alias that auto-tracks Google's
# current flash model if you prefer (smaller free-tier quota).
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
